NODE_ENV=production
HOST=127.0.0.1
PORT=CHANGE_ME

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=CHANGE_ME
DB_AUTO_CREATE=false

JWT_SECRET=CHANGE_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=https://example.com

STORAGE_MONITOR_PATH=/opt/application
STORAGE_LABEL=application-storage

ANDROID_RELEASE_DIR=/opt/dbdwz-android-releases

LIBREOFFICE_BIN=/usr/bin/libreoffice
FFMPEG_BIN=/usr/bin/ffmpeg
OFFICE_PREVIEW_TIMEOUT_MS=240000
VIDEO_PREVIEW_TIMEOUT_MS=300000

# Single Node process only. Use a dedicated upload volume with a filesystem hard
# quota; these app budgets include staging, originals, retained trash and previews.
# Defaults: 10GiB per account, 100GiB total, at least 1GiB left free on every volume.
MATERIAL_ACCOUNT_BYTES=10737418240
MATERIAL_GLOBAL_BYTES=107374182400
MATERIAL_MIN_FREE_BYTES=1073741824
# Optional roots; keep RESOURCE_ROOT and PROFILE_ROOT at the repository defaults
# while migrating an existing deployment (other private modules use those roots).
# MATERIAL_STAGING_ROOT=/var/lib/dbdwz/upload-staging
